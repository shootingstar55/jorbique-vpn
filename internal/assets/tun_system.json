{
  "log": {
    "level": "warn",
    "timestamp": true,
    "output": "logs/tun_system.log"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "singtun",
      "address": [
        "172.31.255.1/30"
      ],
      "auto_route": true,
      "strict_route": true,
      "stack": "system",
      "mtu": 1280,
      "udp_timeout": "5m"
    }
  ],
  "services": [
    {
      "type": "api",
      "tag": "local-api",
      "listen": "127.0.0.1",
      "listen_port": 39217
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache/tun_system/cache.db",
      "cache_id": "tun_system",
      "store_fakeip": false,
      "store_dns": true
    }
  }
}
