{
  "log": {
    "level": "warn",
    "timestamp": true,
    "output": "logs/tun.log"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "singtun",
      "address": [
        "172.31.255.1/30"
      ],
      "auto_route": true,
      "strict_route": true,
      "mtu": 1280,
      "udp_timeout": "5m"
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache/tun/cache.db",
      "cache_id": "tun-v2",
      "store_fakeip": false,
      "store_dns": true
    }
  }
}
