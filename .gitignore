/JorbiqueVPN

# Runtime state the macOS client writes next to the running binary — a dev build
# lives in the repo, so it lands here. sing-box's persistent DNS cache is
# local-only and must never be committed.
cache/

# Last good copy of the downloaded sing-box profile (kept so a blip on the
# update host does not stop the VPN from starting) — runtime state, not source.
internal/macos/cfg/singbox_client.json
cfg/singbox_client.json

